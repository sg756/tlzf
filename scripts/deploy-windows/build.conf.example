# =============================================================================
# FlowOrderArbitrage · Windows 本机编译配置
# 用法：powershell -ExecutionPolicy Bypass -File scripts\deploy-windows\build.ps1
# 没有本文件时脚本会从 build.conf.example 复制一份。
# =============================================================================

# 本机源码根（空 = 仓库根，即 scripts\deploy-windows 的上两级）
SOURCE_ROOT=

# 发布包输出目录（空 = SOURCE_ROOT\dist-release）
# 把这个目录里的内容覆盖到 Linux 的 APP_ROOT（不要传 node_modules、不要传 data）
RELEASE_DIR=

# 便携 Node 目录（没有 Node 18+ 时脚本自动下载到这里，不改系统 PATH）
NODE_HOME=

# true = 不问确认，适合反复发版
SKIP_CONFIRM=true
